# 撮影データは絶対に入れない
*.mp4
*.mov
*.webm
*.m4a
*.wav
*.jsonl
# テスト用の作り物の記録だけは入れる
!analysis/tests/*.jsonl
data/
# 振り返りレポートの出力（記録から作るので入れない）
ability-cam-*.html
framing-checks*.html
sessions.html
*_segments.csv

# 生成物
ios/Pods/
ios/*.xcodeproj/
ios/*.xcworkspace/
# 古い複製（Finder の複製などで「AbilityCam 2.xcodeproj」のようにできたもの。setup.sh がゴミ箱に移す）
ios/AbilityCam *.xcodeproj
ios/AbilityCam *.xcworkspace
ios/Podfile.lock
ios/AbilityCam/Info.plist
ios/AbilityCam/Resources/*.task
xcuserdata/
DerivedData/
build/

# その他
web/*.pem
__pycache__/
analysis/.venv/
.DS_Store
